# Copy to .env.local and fill in for production behaviour.
# The site works with zero configuration — both vars below are optional
# and the app falls back to safe demo behaviour when they're missing.

# Google Imagen API key. Without this, product/lifestyle images render via
# a deterministic placeholder service so the demo still looks complete.
GOOGLE_IMAGEN_API_KEY=
GOOGLE_IMAGEN_MODEL=imagen-3.0-generate-002

# Anthropic API key powering the "AeroPulse Expert" free-text chat
# (app/api/ai-expert/route.ts). Without this, the chat still works using a
# small rule-based Thai keyword extractor (lib/ai-expert-fallback.ts).
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# LINE Official Account Basic ID (starts with "@"), e.g. @aeropulse
# Without this, the LINE handoff screen falls back to a "copy message" button.
NEXT_PUBLIC_LINE_OA_ID=
